# docker-compose 会自动读取同目录的 .env。
# 用法：cp .env.example .env。
#
# 本地默认走 **open-access**（不配 JWT_SECRET）。
#
# 要开鉴权就给它一个真随机值：
#
#   openssl rand -hex 32
#
# 开了之后前端**有**登录页，首个管理员在浏览器里创建
# （GET /api/auth/status → POST /api/auth/bootstrap，见 ADR-026）。
# ⚠️ 但整套 playwright 在鉴权形态下不成立（其余用例都假定"打开就是控制台"），
# 只能跑 e2e/tests/auth-login-flow.spec.ts。
#
# 注意 .env 已在 .gitignore 中，不会入库。

# ── 鉴权 ─────────────────────────────────────────────────
# 本地 open-access（默认）。硬性前提：compose 的四条端口映射必须全部带
# 127.0.0.1: 前缀 —— 由 tools/check_deploy_consistency.py 检查 3c 静态守、
# tools/local-stack.sh 运行时读 netstat 守。要给局域网设备访问时，去掉
# ports 的 127.0.0.1: 前缀并**同时**给 JWT_SECRET（只改一半会被 3c 拦下）。
AUTH_INSECURE=true
# 容器形态下的显式声明（容器必须绑 0.0.0.0，对外可达性由发布层限定）。
# 只认 loopback-published，拼错则 analysis 拒绝启动（fail closed）。
AUTH_INSECURE_EXPOSURE=loopback-published

# 留空 = 不开鉴权；设了则**密钥优先于 AUTH_INSECURE**（setup.go 先看密钥）。
# 别和上面两行同时生效（检查 3c 会报）。
# JWT_SECRET=replace-me-with-openssl-rand-hex-32

# ── CORS（可选，留空 = 不回显任何 ACAO）─────────────────
# SERVER_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── 基础设施 ─────────────────────────────────────────────
# AUD-39：只有**一个**数据库密码变量。它同时喂给 postgres 容器
# （POSTGRES_PASSWORD）与两个应用服务（DATABASE_PASSWORD）。
# 此前分成 DB_PASSWORD 与 DATABASE_PASSWORD 两个变量，默认值恰好相同所以
# 能用，但把密码改成非默认值（改哪个）就必然对不上 —— DB_PASSWORD 已删。
DATABASE_PASSWORD=postgres

# ── 网关限流 ─────────────────────────────────────────────
# 每 ClientIP / 每分钟的请求数上限。缺省 100（docker-compose.yml 的
# ${RATE_LIMIT_PER_MINUTE:-100}，与 config/*-service.yaml 的 rate_limit.per_minute 一致）。
#
# ⚠️ **别在这里调高** —— 缺省值就是本地开发该有的姿势。
# 整套 playwright 需要更高额度（它从 127.0.0.1 **一个 IP** 出量，API 密集的几段
# 必然越过 100/min，于是一批与被测代码无关的用例拿到 429），但那是**测试专用**
# 姿势，走显式覆盖层而不是改默认值（AUD-58）：
#
#   docker compose -f docker-compose.yml -f docker-compose.e2e.yml \
#     up -d --force-recreate --no-deps analysis-service data-service
#
# 跑完恢复默认姿势：
#   docker compose up -d --force-recreate --no-deps analysis-service data-service
#
# RATE_LIMIT_PER_MINUTE=100000

# ── 数据源 ───────────────────────────────────────────────
TUSHARE_TOKEN=

# ── AI（可选）────────────────────────────────────────────
AI_API_KEY=
