{
  "name": "quant-lab-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "dev:bff": "vite --mode bff",
    "lint": "eslint .",
    "lint:tests": "node scripts/lint-tests.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "npm run lint:tests && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.12.0",
    "@vueuse/core": "^11.3.0",
    "chart.js": "^4.4.7",
    "luxon": "^3.4.4",
    "naive-ui": "^2.40.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^0.1.7",
    "@types/luxon": "^3.4.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.8.9",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^6.0.5",
    "vitest": "^4.1.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.0"
  }
}
